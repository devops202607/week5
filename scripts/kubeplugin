#!/usr/bin/env bash

set -euo pipefail

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

for cmd in kubectl awk; do
  if ! command -v "$cmd" &> /dev/null; then
    echo -e "${YELLOW}Error: $cmd is not installed.${NC}" >&2
    exit 1
  fi
done

usage() {
  echo -e "Usage: kubectl stat <namespace> [pod|node]"
  echo -e "Example: kubectl stat kube-system pod"
  exit 1
}

if [ "$#" -lt 1 ]; then
  usage
fi

NAMESPACE="$1"
RESOURCE_TYPE="${2:-pod}"

OUTPUT=$(kubectl top "$RESOURCE_TYPE" -n "$NAMESPACE" --no-headers 2>/dev/null) || {
  echo -e "${YELLOW}Error: Failed to retrieve metrics for '$RESOURCE_TYPE' in namespace '$NAMESPACE'.${NC}" >&2
  exit 1
}

echo -e "${BOLD}Resource, Namespace, Name, CPU, Memory${NC}"

echo "$OUTPUT" | awk \
  -v res="$RESOURCE_TYPE" \
  -v ns="$NAMESPACE" \
  -v c_res="$CYAN" \
  -v c_ns="$BLUE" \
  -v c_name="$GREEN" \
  -v c_cpu="$YELLOW" \
  -v c_mem="$MAGENTA" \
  -v nc="$NC" '
{
  print c_res res nc ", " c_ns ns nc ", " c_name $1 nc ", " c_cpu $2 nc ", " c_mem $3 nc
}'
